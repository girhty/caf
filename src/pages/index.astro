---

<Layout 
  title={data.google_places.name} 
  description={data.instagram.biography}
>
  <!-- Global Navigation Header Bar -->
  <Navbar 
    username={data.instagram.username} 
    profilePic={data.instagram.profile_pic} 
  />

  <main class="relative z-10">
    <!-- Hero Block Showcase -->
    <Hero 
      name={data.google_places.name}
      biography={data.instagram.biography}
      followers={data.instagram.followers_count}
      rating={data.google_places.rating}
      reviewsCount={data.google_places.user_ratings_total}
      profilePic={data.instagram.profile_pic}
      featuredImage={data.instagram.posts[1].image_url}
    />

    <!-- Quick Stats Metric Alignment -->
    <StatsBadge 
      rating={data.google_places.rating}
      totalRatings={data.google_places.user_ratings_total}
      username={data.instagram.username}
    />

    <!-- Infinite Text Marquee Banner for modern motion flow -->
    <div class="bg-gold-500 py-3 overflow-hidden whitespace-nowrap select-none border-y border-gold-600 flex">
      <div class="animate-marquee flex text-espresso-950 font-bold tracking-widest text-xs uppercase gap-8">
        <span>SOCIALLY-DRIVEN SPECIALTY COFFEE HUB • BASRA AL JAZAER • CAF CAFE IQ • </span>
        <span>SOCIALLY-DRIVEN SPECIALTY COFFEE HUB • BASRA AL JAZAER • CAF CAFE IQ • </span>
        <span>SOCIALLY-DRIVEN SPECIALTY COFFEE HUB • BASRA AL JAZAER • CAF CAFE IQ • </span>
        <span>SOCIALLY-DRIVEN SPECIALTY COFFEE HUB • BASRA AL JAZAER • CAF CAFE IQ • </span>
      </div>
    </div>

    <!-- Interactive Bento Layout Grid -->
    <BentoGallery posts={data.instagram.posts} />

    <!-- Community Workshops Section -->
    <Events />

    <!-- Location & Live Status Map Block -->
    <LocationHours 
      address={data.google_places.formatted_address}
      phone={data.google_places.formatted_phone_number}
    />
  </main>

  <!-- Complete Site Footer Layout -->
  <Footer name={data.google_places.name} />
</Layout>