---
interface Props {
  rating: number;
  totalRatings: number;
  username: string;
}

const { rating, totalRatings, username } = Astro.props;
---

<section id="about" class="py-12 bg-espresso-900 border-y border-espresso-800 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-2 md:grid-cols-4 gap-8 text-center relative z-10">
    
    <div class="reveal-on-scroll flex flex-col items-center justify-center">
      <span class="text-3xl md:text-4xl font-extrabold text-gold-400 tracking-tight font-sans">3.6</span>
      <span class="text-xs uppercase tracking-wider text-cream-300 mt-2">Google Rating ⭐</span>
    </div>
    
    <div class="reveal-on-scroll delay-100 flex flex-col items-center justify-center border-l border-espresso-800">
      <span class="text-3xl md:text-4xl font-extrabold text-cream-50 tracking-tight font-sans">49+</span>
      <span class="text-xs uppercase tracking-wider text-cream-300 mt-2">Verified Reviews</span>
    </div>

    <div class="reveal-on-scroll delay-200 flex flex-col items-center justify-center border-l border-espresso-800">
      <span class="text-3xl md:text-4xl font-extrabold text-gold-400 tracking-tight font-sans">36,000+</span>
      <span class="text-xs uppercase tracking-wider text-cream-300 mt-2">Instagram Followers</span>
    </div>

    <div class="reveal-on-scroll delay-300 flex flex-col items-center justify-center border-l border-espresso-800">
      <span class="text-3xl md:text-4xl font-extrabold text-cream-50 tracking-tight font-arabic">٧ ص - ١٢ م</span>
      <span class="text-xs uppercase tracking-wider text-cream-300 mt-2 font-arabic">ساعات العمل اليومية</span>
    </div>

  </div>
</section>