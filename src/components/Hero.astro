---
interface Props {
  name: string;
  biography: string;
  followers: number;
  rating: number;
  reviewsCount: number;
  profilePic: string;
  featuredImage: string;
}

const { name, biography, followers, rating, reviewsCount, profilePic, featuredImage } = Astro.props;

// Formatting followers count beautifully
const formattedFollowers = (followers / 1000).toFixed(1) + 'K';
---

<section id="hero" class="relative min-h-screen flex items-center justify-center pt-24 pb-16 overflow-hidden px-4 md:px-8">
  <!-- Subtle Grid Overlay -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f1d1c_1px,transparent_1px),linear-gradient(to_bottom,#1f1d1c_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-30"></div>
  
  <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
    
    <!-- Hero Text Left -->
    <div class="lg:col-span-7 flex flex-col text-center lg:text-left items-center lg:items-start animate-fade-in-up">
      
      <!-- Combined Google + Insta Trust Badges -->
      <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 mb-6">
        <div class="flex items-center gap-2 glassmorphism-light px-3 py-1.5 rounded-full border border-gold-500/20 shadow-sm">
          <span class="text-amber-400 text-xs">⭐</span>
          <span class="text-xs font-bold text-cream-50 font-sans">{rating} on Google</span>
          <span class="text-[10px] text-cream-300">({reviewsCount} reviews)</span>
        </div>
        
        <a href="https://instagram.com/cafcafeiq" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 glassmorphism-light px-3 py-1.5 rounded-full border border-cream-100/10 hover:border-gold-500/30 transition-all duration-300 group">
          <svg class="w-3.5 h-3.5 text-pink-400 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
          <span class="text-xs font-semibold text-cream-100">{formattedFollowers} Community</span>
        </a>
      </div>

      <!-- Main Headline - Bilingual Punchy Concept -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-cream-50 leading-[1.1] mb-6">
        Socially-Driven <br class="hidden sm:inline"/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-400 via-gold-500 to-amber-600">
          Specialty Coffee
        </span>
      </h1>
      
      <p class="text-3xl sm:text-4xl font-arabic font-bold text-cream-200 tracking-normal mb-6 text-right lg:text-left w-full leading-relaxed">
        لأن القهوة تجمعنا 🤍
      </p>

      <!-- Biography interpretation with Arabic support -->
      <p class="text-base text-cream-300 max-w-xl font-arabic leading-loose mb-8 whitespace-pre-line text-center lg:text-left">
        {biography}
      </p>

      <!-- Action Buttons with custom subtle micro-interactions -->
      <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
        <a 
          href="#feed" 
          class="w-full sm:w-auto bg-gradient-to-r from-gold-500 to-gold-600 hover:from-gold-400 hover:to-gold-500 text-espresso-950 font-bold px-8 py-4 rounded-xl text-sm tracking-wider uppercase transition-all duration-300 transform hover:-translate-y-0.5 shadow-xl shadow-gold-600/10 text-center"
        >
          Explore Experiences & Menu
        </a>
        <a 
          href="#location" 
          class="w-full sm:w-auto glassmorphism hover:bg-espresso-800 text-cream-100 font-semibold px-8 py-4 rounded-xl text-sm tracking-wider uppercase transition-all duration-300 border border-cream-200/10 text-center"
        >
          Find Us in Basra
        </a>
      </div>
    </div>

    <!-- Hero Visual Artwork Right (Bento Card Aesthetic) -->
    <div class="lg:col-span-5 relative mt-8 lg:mt-0 animate-fade-in delay-200">
      <div class="relative mx-auto max-w-[400px] lg:max-w-none aspect-square">
        <!-- Back geometric element -->
        <div class="absolute inset-4 rounded-3xl bg-espresso-800 border border-gold-500/10 transform rotate-3 scale-105 transition-transform duration-700 hover:rotate-1"></div>
        
        <!-- Main image container with custom shadow and glass overlay tag -->
        <div class="absolute inset-0 rounded-3xl overflow-hidden border border-cream-200/10 shadow-2xl group">
          <img 
            src={featuredImage} 
            alt="CAF Specialty Coffee Atmosphere" 
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-espresso-950/80 via-transparent to-transparent"></div>
          
          <!-- Embedded Live indicator / Experience Tag -->
          <div class="absolute bottom-6 left-6 right-6 glassmorphism p-4 rounded-2xl flex items-center justify-between">
            <div>
              <p class="text-[10px] uppercase tracking-widest text-gold-400 font-bold">Featured Hub</p>
              <p class="text-sm font-bold text-cream-50 font-arabic">البصرة، الجزائر</p>
            </div>
            <div class="w-10 h-10 rounded-full bg-espresso-900 border border-gold-500/20 flex items-center justify-center text-gold-400">
              ☕
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>